{
  "manifest_version": 3,
  "name": "Mai-Score",
  "version": "0.22.0",
  "description": "Collect and review maimai DX, DDR, SOUND VOLTEX, and beatmania IIDX data locally.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Mai-Score",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://maimaidx-eng.com/maimai-mobile/*",
    "https://maimaidx.jp/maimai-mobile/*",
    "https://p.eagate.573.jp/game/sdvx/*",
    "https://p.eagate.573.jp/game/2dx/*",
    "https://p.eagate.573.jp/game/ddr/*",
    "https://shama.dxrating.net/images/cover/v2/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://mai-score.milifix.com/*"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://maimaidx-eng.com/maimai-mobile/*",
        "https://maimaidx.jp/maimai-mobile/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://p.eagate.573.jp/game/sdvx/*",
        "https://p.eagate.573.jp/game/2dx/*",
        "https://p.eagate.573.jp/game/ddr/*"
      ],
      "js": [
        "konami-content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
